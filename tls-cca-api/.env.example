SUPERUSER_USERNAME=username
SUPERUSER_EMAIL=example@xyz.com
SUPERUSER_PASSWORD=PASSWORD
SUPERUSER_FIRSTNAME=Firstname
SUPERUSER_LASTNAME=LASTNAME
SUPERUSER_BIRTHDAY=1990-01-01

DJANGO_SECRET_KEY='change-me'
DJANGO_DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (omit DB_NAME for local SQLite development)
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=mypassword
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

TOTP_ISSUER=TLS CCA
# Recommended in production; when absent the key is derived from DJANGO_SECRET_KEY.
TOTP_ENCRYPTION_KEY=

EMAIL_HOST_USER=example@xyz.com
EMAIL_HOST_PASSWORD=PASSWORD
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
SECURE_SSL_REDIRECT=False
