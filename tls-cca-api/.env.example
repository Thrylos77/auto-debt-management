SUPERUSER_USERNAME=username
SUPERUSER_EMAIL=example@xyz.com
SUPERUSER_PASSWORD=PASSWORD
SUPERUSER_FIRSTNAME=Firstname
SUPERUSER_LASTNAME=LASTNAME
SUPERUSER_BIRTHDAY=1990-01-01

DJANGO_SECRET_KEY='change-me'
DJANGO_DEBUG=True
DJANGO_ENV=development
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (omit DB_NAME for local SQLite development)
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=mypassword
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

TOTP_ISSUER=TLS CCA
# Recommended in production; when absent the key is derived from DJANGO_SECRET_KEY.
TOTP_ENCRYPTION_KEY=

EMAIL_HOST_USER=example@xyz.com
EMAIL_HOST_PASSWORD=PASSWORD
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
SECURE_SSL_REDIRECT=False

# CORS / browser clients: comma-separated exact origins. Leave empty to deny CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request hardening
API_MAX_REQUEST_BYTES=10485760
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
DATA_UPLOAD_MAX_NUMBER_FILES=100
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

# JWT hardening (production must use a dedicated signing key).
JWT_SIGNING_KEY=change-me-with-a-long-random-value-of-at-least-64-characters-please
JWT_AUDIENCE=tls-cca-api
JWT_ISSUER=tls-cca-api
TRUST_PROXY_SSL=False

# Authentication public links (frontend URLs used in security emails)
AUTH_PUBLIC_BASE_URL=http://localhost:3000
AUTH_INVITATION_PATH=/auth/invitation
AUTH_PASSWORD_RESET_PATH=/auth/password/reset
AUTH_TWOFA_RECOVERY_PATH=/auth/2fa/recovery
